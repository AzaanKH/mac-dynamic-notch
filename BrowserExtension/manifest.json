{
  "manifest_version": 3,
  "name": "NotchRouter Browser Bridge",
  "version": "0.2.0",
  "description": "Shows active browser media and optional download progress in NotchRouter.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Enable NotchRouter download progress"
  }
}
