{
  "manifest_version": 3,
  "name": "NotchRouter Browser Media",
  "version": "0.1.0",
  "description": "Shows active browser media in NotchRouter and relays supported playback controls.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NotchRouter Browser Media"
  }
}
